{
  "schemaVersion": 1,
  "contractId": "haven42.installation-broker",
  "implementationStatus": "simulation-only",
  "runtimeAdmitted": false,
  "requiredRequestFields": [
    "schemaVersion",
    "operation",
    "componentId",
    "platformProfileId",
    "currentState",
    "promotionEvidence",
    "approvalToken"
  ],
  "operations": ["plan-install", "plan-upgrade", "plan-uninstall"],
  "currentStates": ["absent", "present", "unknown"],
  "promotionEvidenceFields": [
    "immutableIdentityAvailable",
    "checksumAvailable",
    "signatureOrAttestationAvailable",
    "licenseReviewed",
    "platformLifecycleEvidenceAvailable"
  ],
  "requestPolicy": {
    "unknownFieldsAllowed": false,
    "registeredComponentIdsOnly": true,
    "immutableVersionRequiredForRealInstall": true,
    "rawUrlAllowed": false,
    "rawCommandAllowed": false,
    "rawPathAllowed": false,
    "argumentsAllowed": false,
    "environmentAllowed": false,
    "rendererEvidenceAllowed": false,
    "scenarioEvidenceIsAuthority": false,
    "rendererApprovalDecisionAllowed": false
  },
  "approval": {
    "opaque": true,
    "singleUse": true,
    "sessionBound": true,
    "componentVersionPlatformAndEffectsBound": true,
    "rememberApprovalAllowed": false
  },
  "lifecyclePolicy": {
    "installRequiresAbsentState": true,
    "upgradeAndUninstallRequirePresentState": true,
    "unknownStateDecision": "deny",
    "replayAllowed": false,
    "downgradeAllowed": false,
    "simulationMayPromoteComponent": false
  },
  "events": [
    "accepted",
    "inspecting",
    "planning",
    "approval-required",
    "downloading",
    "verifying",
    "installing",
    "validating",
    "rolling-back",
    "completed",
    "failed"
  ],
  "simulationEffects": {
    "networkUsed": false,
    "filesWritten": false,
    "installationPerformed": false,
    "elevationRequested": false,
    "servicesChanged": false,
    "driversChanged": false
  },
  "realInstallPromotionRequires": [
    "immutable package identity",
    "license review",
    "publisher signature or attestation verification",
    "checksum verification",
    "exact OS and architecture evidence",
    "install and health validation",
    "loopback-only provider binding or separately admitted private-network HTTPS gateway evidence",
    "certificate trust rotation and exact cleanup evidence for private-network profiles",
    "upgrade and rollback validation",
    "uninstall and cleanup validation",
    "OS-controlled elevation",
    "hosted cross-platform checks"
  ]
}
