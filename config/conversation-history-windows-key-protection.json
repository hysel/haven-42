  },
  "authority": {
    "syntheticDevelopmentValidationAllowed": true,
    "runtimeRouteAllowed": false,
    "uiControlAllowed": false,
    "userContentAllowed": false,
    "databaseOpenAllowed": false,
    "databaseCreateAllowed": false,
    "persistentKeyWriteAllowed": false,
    "packageAdmissionAllowed": false,
    "productionUseAllowed": false
  }
}
