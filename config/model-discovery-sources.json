{
  "schemaVersion": 1,
  "description": "Public metadata sources and source-specific seed queries for optional model discovery.",
  "defaultSources": ["official-publishers", "ollama-newest", "ollama", "huggingface"],
  "sources": [
    {
      "id": "official-publishers",
      "type": "huggingface-publisher-feed",
      "baseUrl": "https://huggingface.co",
      "lookbackDays": 45,
      "eligiblePipelineTags": [
        "text-generation",
        "image-text-to-text",
        "feature-extraction",
        "sentence-similarity",
        "automatic-speech-recognition",
        "text-to-audio"
      ],
      "publisherNamespaces": [
        "Qwen",
        "google",
        "mistralai",
        "nvidia",
        "microsoft",
        "ibm-granite",
        "CohereLabs",
        "LiquidAI",
        "zai-org",
        "allenai",
        "moonshotai",
        "MiniMaxAI",
        "openai",
        "deepseek-ai",
        "meta-llama",
        "ByteDance-Seed",
        "OpenGVLab"
      ]
    },
    {
      "id": "ollama-newest",
      "type": "ollama-newest-index",
      "baseUrl": "https://ollama.com/library?sort=newest",
      "detailBaseUrl": "https://ollama.com/library",
      "description": "Newest-first registry index used to discover family names that are absent from seed queries."
    },
    {
      "id": "ollama",
      "type": "ollama-library",
      "baseUrl": "https://ollama.com/library",
      "defaultQueries": [
        "qwen3.5",
        "qwen3.6",
        "qwen3.8",
        "qwen3-coder",
        "gemma3",
        "gemma4",
        "granite4.1",
        "phi4-mini",
        "llama3.2",
        "ministral-3",
        "mistral-small3.2",
        "muse-glimmer",
        "nemotron-3.5-lightning",
        "devstral",
        "gpt-oss",
        "glm-4.7-flash",
        "laguna-xs-2.1"
      ]
    },
    {
      "id": "huggingface",
      "type": "huggingface-hub",
      "baseUrl": "https://huggingface.co",
      "defaultQueries": ["local text generation", "agentic coding", "tool calling", "reasoning", "GGUF", "MLX"]
    }
  ]
}
