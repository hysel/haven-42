{
  "schemaVersion": 1,
  "contractId": "haven42.document-context.lexical-retrieval-foundation",
  "status": "offline-engine-implemented-not-runtime-admitted",
  "activation": {
    "runtimeRouteAllowed": false,
    "uiControlAllowed": false,
    "providerPayloadAllowed": false,
    "backgroundIndexingAllowed": false
  },
  "inputBoundary": {
    "validatedMemoryAttachmentsOnly": true,
    "allowedExtensions": [".txt", ".md", ".csv", ".json"],
    "filesystemPathsAllowed": false,
    "directorySelectionAllowed": false,
    "temporaryFilesAllowed": false,
    "additionalParsersAllowed": false,
    "networkAllowed": false
  },
  "determinism": {
    "algorithm": "bounded-casefolded-term-frequency",
    "normalization": "unicode-casefold",
    "tokenization": "unicode-alphanumeric-runs-without-underscore",
    "chunking": "fixed-character-windows-no-overlap",
    "semanticEmbeddingsAllowed": false,
    "modelRankingAllowed": false,
    "remoteRankingAllowed": false,
    "stableTieBreak": "attachment-order-then-chunk-offset"
  },
  "budgets": {
    "maximumQueryCharacters": 512,
    "maximumAttachments": 5,
    "maximumSourceBytes": 131072,
    "maximumChunkCharacters": 2000,
    "maximumChunksPerAttachment": 64,
    "maximumSelectedChunks": 8,
    "maximumSelectedCharacters": 12000
  },
  "resultBoundary": {
    "sourceNameRequired": true,
    "sourceOffsetRequired": true,
    "tokenEstimateRequired": true,
    "selectedChunkDisclosureRequired": true,
    "contentTreatedAsUntrustedData": true,
    "contentAuthorityAllowed": false
  },
  "lifecycle": {
    "memoryOnly": true,
    "persistentIndexAllowed": false,
    "browserStorageAllowed": false,
    "cleanupOnTaskBoundaryRequired": true,
    "cleanupOnFailureRequired": true,
    "cleanupOnShutdownRequired": true
  },
  "implementation": {
    "module": "scripts/memory_lexical_retrieval.py",
    "test": "scripts/test-memory-lexical-retrieval.py",
    "runtimeImported": false,
    "filesystemApiUsed": false,
    "networkApiUsed": false,
    "providerApiUsed": false
  },
  "hostileFixture": "examples/fixtures/lexical-retrieval-hostile-cases.json"
}
