{
  "schemaVersion": 1,
  "contractId": "haven42.task-composition.plan-only",
  "mode": "simulation-only",
  "executionAllowed": false,
  "maximumSteps": 6,
  "maximumDependenciesPerStep": 5,
  "allowedSafetyLevels": [
    "read-only"
  ],
  "request": {
    "requiredFields": [
      "schemaVersion",
      "compositionId",
      "steps",
      "cancelRequested",
      "lifecycle"
    ],
    "stepFields": [
      "stepId",
      "workflowId",
      "dependsOn"
    ],
    "argumentsAllowed": false,
    "approvalGrantsAccepted": false,
    "lifecycleFields": [
      "attempt",
      "retryOf",
      "mode"
    ],
    "lifecycleModes": [
      "fresh",
      "retry",
      "cancel"
    ],
    "maximumAttempts": 2
  },
  "result": {
    "states": [
      "planned",
      "cancelled",
      "rejected"
    ],
    "executionFieldsAllowed": false,
    "intermediateArtifacts": {
      "mode": "metadata-only",
      "schemaVersion": 1,
      "contentAllowed": false,
      "typedValidationRequired": true
    },
    "events": [
      "accepted",
      "step-planned",
      "retry-planned",
      "cancelled",
      "result",
      "error"
    ]
  },
  "security": {
    "registryBackedWorkflowsOnly": true,
    "uiReadyWorkflowsOnly": true,
    "cycleRejectionRequired": true,
    "unknownFieldRejectionRequired": true,
    "retryIdentityRequired": true,
    "retryReplayAllowed": false,
    "resumeAfterExecutionAllowed": false,
    "approvalAuthority": "engine-owned",
    "rendererApprovalGrantsAccepted": false,
    "processCreationAllowed": false,
    "filesystemAccessAllowed": false,
    "networkAccessAllowed": false,
    "machineModificationAllowed": false
  }
}
