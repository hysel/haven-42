{
  "schemaVersion": 1,
  "runtimeId": "haven42.local-web",
  "implementationStatus": "text-tools-workflow-planning-and-promoted-image-admitted",
  "bind": {
    "allowedAddresses": ["127.0.0.1"],
    "defaultPort": 4242,
    "remoteBindAllowed": false
  },
  "browser": {
    "bundledAssetsOnly": true,
    "remoteAssetsAllowed": false,
    "telemetryAllowed": false,
    "crossOriginRequestsAllowed": false,
    "automaticLaunchUrlScope": "ipv4-loopback-http-origin-only",
      "fixedExternalNavigationUrls": [
        "https://github.com/hysel/haven-42/wiki/Model-And-Hardware-Test-Status",
        "https://github.com/hysel/haven-42/issues/new?template=alpha-bug-report.yml",
        "https://ollama.com/download/windows",
        "https://ollama.com/download/linux"
      ],
    "fixedExternalNavigationRequiresExplicitClick": true,
    "rendererSuppliedExternalNavigationAllowed": false,
    "environmentOverrideAllowed": false,
    "shellLaunchAllowed": false,
    "hostHeaderValidationRequired": true,
    "csrfTokenRequiredForEffects": true,
    "contentSecurityPolicyRequired": true
  },
  "browserPreferences": {
    "storageKey": "haven42.section-tours.v1",
    "allowedFields": ["chat", "models", "system", "technical", "about"],
    "allowedValueType": "positive-integer-tour-revision",
    "staleBooleanValuesTreatedAsUnseen": true,
    "newRevisionRetriggersOnlyChangedSection": true,
    "tourProgressPersistenceAllowed": false,
    "conversationContentAllowed": false,
    "attachmentInformationAllowed": false,
    "modelOrProviderInformationAllowed": false,
    "systemOrIdentityInformationAllowed": false,
    "credentialsAllowed": false
  },
  "providerConnections": {
    "configuredInMemoryOnly": true,
    "allowedTrustScopes": ["loopback", "trusted-lan"],
    "allowedTransportSchemes": ["http", "https"],
    "trustScopeSelection": "server-inferred-from-ip-literal",
    "transportSchemeSelection": "server-validated-normalized-provider-url",
    "httpWarningRequired": true,
    "privateNetworkHttpWarningSeverity": "security-warning",
    "loopbackHttpWarningSeverity": "same-machine-notice",
    "ipLiteralRequired": true,
    "credentialsInUrlAllowed": false,
    "authentication": {
      "allowedModes": ["none", "bearer", "x-api-key"],
      "bearerHeader": "Authorization",
      "apiKeyHeader": "X-API-Key",
      "arbitraryHeaderNamesAllowed": false,
      "maximumKeyBytes": 4096,
      "keyCharacterSet": "visible-ascii-no-whitespace",
      "privateNetworkHttpsRequired": true,
      "loopbackHttpAllowed": true,
      "memoryOnly": true,
      "responseDisclosureAllowed": false,
      "loggingAllowed": false,
      "evidenceInclusionAllowed": false,
      "blankReuseScope": "same-process-same-normalized-endpoint-and-mode"
    },
    "redirectsAllowed": false,
    "modelDiscoveryRequiredBeforeUse": true
  },
  "modelDiscovery": {
    "installedSearchNetworkAllowed": false,
    "publicCatalogSource": "https://ollama.com/search",
    "explicitOnlineConsentRequired": true,
    "queryPersistenceAllowed": false,
    "repositoryContentSent": false,
    "hardwareProfileSent": false,
    "maximumQueryCharacters": 64,
    "maximumResults": 20,
    "redirectsAllowed": false,
    "candidateExecutionRequiresInstalledInventoryMatch": true,
    "automaticDownloadsAllowed": false,
    "pullApiAllowed": false,
    "commandExecutionAllowed": false,
    "copyableInstructionAllowed": true
  },
  "readiness": {
    "explicitUserActionRequired": true,
    "csrfTokenRequired": true,
    "registeredReadOnlyProbesOnly": true,
    "snapshotPersistenceAllowed": false,
    "rendererHardwareFactsAccepted": false,
    "setupPlansMayInstall": false,
    "installationBrokerStatus": "simulation-only-not-runtime-admitted"
  },
  "text": {
    "capabilityIds": ["general.chat", "content.write", "content.summarize"],
    "providerId": "ollama.local-text",
    "repositoryAccess": false,
    "fileWrites": false,
    "messagePersistence": false,
    "endpointPersistence": false,
    "modelDownloads": false,
    "maximumRequestBytes": 12582912,
    "maximumConversationBytes": 65536,
    "maximumMessageBytes": 32768,
    "maximumConversationMessages": 20,
    "browserConversationSurface": "single-continuous-conversation",
    "browserIntentHint": "narrow-prefix-browser-memory-only",
    "browserIntentHintAddsAuthority": false,
    "taskIntentChangeClearsConversation": false,
    "chatTextSizeControl": {
      "allowedValues": ["small", "default", "large", "extra-large"],
      "defaultValue": "default",
      "messageAndPromptOnly": true,
      "persistenceAllowed": false,
      "providerPayloadChanged": false
    },
    "differentModelRequiresExplicitConfirmation": true,
    "automaticTaskModelSwitchAllowed": false,
    "modelSelection": "immutable-digest-and-capability-evidence-gated-automatic-with-advanced-per-capability-browser-memory-override",
    "recommendationAuthority": "server-owned-static-catalog",
    "unknownInstalledModelState": "unverified",
    "automaticUnknownModelSelectionAllowed": false,
    "manualUnverifiedSelectionAddsAuthority": false,
    "missingModelDownloadsAllowed": false,
    "modelResidency": "bounded-idle-timeout",
    "defaultIdleUnloadSeconds": 300,
    "allowedIdleUnloadSeconds": [0, 300, 900, 1800],
    "unloadOnFailure": true,
    "unloadOnNewTask": true,
    "unloadOnModelOrProviderChange": true,
    "unloadOnShutdown": true,
    "maximumResponseBytes": 1048576
  },
  "documentContext": {
    "contract": "config/document-context-policy.json",
    "status": "bounded-inert-attachment-admitted",
    "browserSelectionOnly": true,
    "allowedExtensions": [".txt", ".md", ".csv", ".json", ".cs", ".py", ".js", ".jsx", ".ts", ".tsx", ".java", ".go", ".rs", ".sql", ".tf"],
    "sourceTextExtensions": [".cs", ".py", ".js", ".jsx", ".ts", ".tsx", ".java", ".go", ".rs", ".sql", ".tf"],
    "sourceTextNormalizedMediaType": "text/plain",
    "sourceTextExecutionAllowed": false,
    "structuredTextSyntaxValidationRequired": true,
    "structuredTextFormulaEvaluationAllowed": false,
    "maximumFiles": 5,
    "maximumBytesPerFile": 65536,
    "maximumTotalBytes": 131072,
    "clipboardScreenshotMediaTypes": ["image/png"],
    "screenshotFilePickerAllowed": true,
    "defaultMaximumScreenshots": 2,
    "maximumScreenshots": 4,
    "maximumBytesPerScreenshot": 4194304,
    "maximumScreenshotTotalBytes": 8388608,
    "maximumScreenshotDimension": 4096,
    "maximumScreenshotPixels": 16777216,
    "maximumScreenshotTotalPixels": 33554432,
    "imageInputEvidence": "unverified-visible-warning",
    "attachmentContentTreatedAsData": true,
    "contentDrivenProcessLaunchAllowed": false,
    "contentDrivenToolInvocationAllowed": false,
    "contentDrivenFilesystemAccessAllowed": false,
    "modelOutputExecutionAllowed": false,
    "antivirusScanningClaimed": false,
    "memoryOnly": true,
    "temporaryFilesAllowed": false,
    "privateNetworkConfirmationRequired": true,
    "privateNetworkWarningRequired": true,
    "privateNetworkConfirmationMechanism": "deliberate-submit-after-visible-warning",
    "separateConfirmationControlRequired": false,
    "publicProviderAllowed": false
  },
  "inactiveFoundations": {
    "lexicalRetrieval": {
      "contract": "config/lexical-retrieval-contract.json",
      "status": "simulation-only-not-runtime-admitted",
      "runtimeRouteAllowed": false,
      "uiControlAllowed": false,
      "providerPayloadAllowed": false
    },
    "webResearch": {
      "contract": "config/web-research-contract.json",
      "status": "proposed-offline-fixtures-only",
      "runtimeRouteAllowed": false,
      "modelToolAllowed": false,
      "networkAllowed": false
    },
    "conversationHistory": {
      "contract": "config/conversation-history-contract.json",
      "schema": "config/conversation-history-schema.json",
      "status": "simulation-only-not-runtime-admitted",
      "runtimeRouteAllowed": false,
      "uiControlAllowed": false,
      "databaseOpenAllowed": false,
      "databaseCreateAllowed": false,
      "filesystemWriteAllowed": false,
      "browserStorageAllowed": false
    }
  },
  "runDetails": {
    "providerReportedOnly": true,
    "fields": ["inputTokens", "outputTokens", "totalTokens", "tokensPerSecond", "totalDurationMs", "loadDurationMs", "promptDurationMs", "generationDurationMs"],
    "billingClaimAllowed": false,
    "remainingContextClaimAllowed": false,
    "persistenceAllowed": false
  },
  "softwareWorkflows": {
    "registry": "config/workflows.json",
    "admittedSafetyLevel": "read-only",
    "uiReadyRequired": true,
    "executionMode": "plan-only",
    "rendererArgumentsAllowed": false,
    "arbitraryCommandsAllowed": false,
    "processStartAllowed": false
  },
  "images": {
    "capabilityId": "media.image.create",
    "providerId": "comfyui.local-image",
    "admittedProfile": "linux-comfyui-sdxl-promoted",
    "model": "sd_xl_base_1.0.safetensors",
    "endpointTrustScope": "loopback",
    "customNodesAllowed": false,
    "externalApiNodesAllowed": false,
    "localFileWritesAllowed": false,
    "delivery": "browser-memory-user-triggered-download",
    "providerRetentionDisclosureRequired": true,
    "historyCleanupRequired": true,
    "maximumImageBytes": 16777216
  },
  "executionEvents": {
    "contract": "config/workflow-envelope-contract.json",
    "reliabilityContract": "config/workflow-reliability-contract.json",
    "monotonicSequenceRequired": true,
    "exactlyOneTerminalEvent": true,
    "eventsAfterTerminalAllowed": false,
    "automaticRetryAllowed": false,
    "retryRequiresNewRequest": true,
    "failedInputPersistenceAllowed": false,
    "failedInputBrowserRestorationAllowed": true,
    "unverifiedModelWarningRequired": true
  },
  "updates": {
    "displayStatusAllowed": true,
    "defaultMode": "disabled",
    "offlineFixtureEvaluationAllowed": true,
    "networkChecksAllowed": false,
    "downloadsAllowed": false,
    "stagingAllowed": false,
    "activationAllowed": false
  },
  "portableDevelopmentPackage": {
    "contract": "config/portable-development-package-contract.json",
    "sharedBrowserUi": true,
    "resourceIntegrityRequiredWhenFrozen": true,
    "shutdownRequiresSessionAuthority": true,
    "unsignedDevelopmentOnly": true
  }
}
