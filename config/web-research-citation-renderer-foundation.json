{
  "schemaVersion": 1,
  "contractId": "haven42.web-research.trusted-citation-renderer-foundation",
  "status": "dormant-fixed-provider-renderer-no-navigation-authority",
  "input": {
    "sourceAccountingContract": "scripts/offline_web_research_boundary.py#account_synthesis",
    "exactTopLevelFieldsRequired": true,
    "exactCitationFieldsRequired": true,
    "maximumCitations": 10,
    "maximumTitleCharacters": 200,
    "citationIdPattern": "^source-[0-9a-f]{20}$",
    "fixedDisplayDomain": "en.wikipedia.org",
    "fixedDestinationPattern": "^https://en\\.wikipedia\\.org/\\?curid=[1-9][0-9]{0,19}$",
    "duplicateCitationIdsAllowed": false,
    "duplicateDestinationsAllowed": false
  },
  "rendering": {
    "textContentOnly": true,
    "modelMarkdownAllowed": false,
    "activeLinksAllowed": false,
    "fullDestinationDisclosureRequired": true,
    "remoteMediaAllowed": false,
    "remoteStylesAllowed": false,
    "remoteScriptsAllowed": false,
    "framesAllowed": false,
    "downloadsAllowed": false,
    "trackingAllowed": false,
    "screenReaderStatusRequired": true,
    "forcedColorsSupported": true,
    "packageIncludedAsDormantComponent": true
  },
  "lifecycle": {
    "memoryOnly": true,
    "clearOnNewTask": true,
    "persistenceAllowed": false,
    "telemetryAllowed": false
  },
  "authority": {
    "automaticInvocationAllowed": false,
    "runtimeRouteAllowed": false,
    "modelToolAllowed": false,
    "networkAllowed": false,
    "dnsAllowed": false,
    "urlFetchAllowed": false,
    "pageRetrievalAllowed": false,
    "activeNavigationAllowed": false,
    "automaticFollowUpAllowed": false
  }
}
