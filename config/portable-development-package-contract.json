{
  "schemaVersion": 1,
  "packageId": "haven42.portable-development",
  "status": "unsigned-development-only",
  "format": "pyinstaller-one-folder",
  "platforms": ["windows", "linux", "macos"],
  "runtime": {
    "browserUiSharedWithSource": true,
    "bindAddresses": ["127.0.0.1"],
    "globalPythonRequired": false,
    "administratorAccessRequired": false,
    "systemServiceAllowed": false,
    "installerAllowed": false,
    "tauriOrRustAdmitted": false
  },
  "security": {
    "buildDependenciesRequireExactVersionsAndHashes": true,
    "buildDependencyInventoryAllowlistedByPlatform": true,
    "strictBundledResourceAllowlist": true,
    "resourceDigestAlgorithm": "sha256",
    "wholePackageFileInventoryRequired": true,
    "archiveTraversalAndLinkRejectionRequired": true,
    "archiveCaseCollisionRejectionRequired": true,
    "archiveMemberCountLimit": 10000,
    "archiveMemberSizeLimitBytes": 134217728,
    "archiveTotalSizeLimitBytes": 536870912,
    "checksumCoverageMustBeExact": true,
    "unexpectedRequestPathsRejected": true,
    "browserUrlIsEngineConstructedLoopbackOnly": true,
    "browserEnvironmentOverrideAllowed": false,
    "browserLaunchShellAllowed": false,
    "browserLaunchExecutables": {
      "windows": ["registered-url-association"],
      "linux": ["/usr/bin/gio", "/usr/bin/xdg-open"],
      "macos": ["/usr/bin/open"]
    },
    "browserLaunchFailureMode": "print-loopback-url-and-continue",
    "arbitraryProcessLaunchAllowed": false,
    "shutdownRequiresOriginAndSessionToken": true,
    "modelCleanupRequiredBeforeShutdown": true
  },
  "nativeSmokeTests": {
    "sourcePackagedParityRequired": true,
    "relocationRequired": true,
    "readOnlyPackageStartupRequired": true,
    "abruptExitRecoveryRequired": true,
    "repeatedLifecycleRequired": true,
    "occupiedPortFailureRequired": true,
    "hostileEnvironmentRequired": true,
    "resourceTamperRejectionRequired": true
  },
  "supplyChainEvidence": [
    "SHA256SUMS",
    "build-provenance.json",
    "dependency-inventory.json",
    "package-file-inventory.json",
    "THIRD-PARTY-NOTICES.txt",
    "haven42.cdx.json"
  ],
  "distribution": {
    "signed": false,
    "notarized": false,
    "githubReleasePublicationAllowed": false,
    "productionReadinessClaimAllowed": false
  },
  "provenance": {
    "exactSourceCommitRequired": true,
    "operatingSystemArchitecturePythonAndPyInstallerRecorded": true,
    "artifactAttestationProduced": false
  },
  "installerFoundation": {
    "mode": "simulation-only",
    "machineModificationAllowed": false
  },
  "updaterFoundation": {
    "mode": "offline-policy-only",
    "networkActivationAllowed": false,
    "downloadAllowed": false,
    "stagingAllowed": false,
    "activationAllowed": false
  }
}
