{
  "schemaVersion": 1,
  "status": "bounded-inert-attachment-admitted",
  "selection": {
    "explicitBrowserFileSelectionRequired": true,
    "directorySelectionAllowed": false,
    "backgroundScanningAllowed": false,
    "arbitraryPathInputAllowed": false,
    "pathSentToEngine": false
  },
  "formats": {
    "allowedExtensions": [".txt", ".md", ".csv", ".json", ".cs", ".py", ".js", ".jsx", ".ts", ".tsx", ".java", ".go", ".rs", ".sql", ".tf"],
    "allowedMediaTypes": ["text/plain", "text/markdown", "text/csv", "application/json"],
    "utf8Required": true,
    "structuredText": {
      "jsonSyntaxValidationRequired": true,
      "maximumJsonDepth": 64,
      "maximumJsonContainerNodes": 10000,
      "csvSyntaxValidationRequired": true,
      "maximumCsvRows": 2000,
      "maximumCsvColumns": 256,
      "maximumCsvCellCharacters": 8192,
      "formulaEvaluationAllowed": false
    },
    "sourceText": {
      "allowedExtensions": [".cs", ".py", ".js", ".jsx", ".ts", ".tsx", ".java", ".go", ".rs", ".sql", ".tf"],
      "normalizedMediaType": "text/plain",
      "syntaxValidationClaimed": false,
      "executionAllowed": false
    },
    "contentIdentity": {
      "fileNameTrusted": false,
      "browserMediaTypeTrusted": false,
      "browserPreflightRequired": true,
      "serverRevalidationRequired": true,
      "binaryAndContainerSignatureRejectionRequired": true,
      "controlCharacterRejectionRequired": true,
      "highConfidenceScriptMasqueradeRejectionRequired": true,
      "ambiguousTextAllowedOnlyAsInertData": true,
      "blockedScriptFamilies": ["powershell", "posix-shell", "windows-batch"],
      "antivirusClaimed": false
    },
    "archivesAllowed": false,
    "pdfAllowed": false,
    "officeDocumentsAllowed": false,
    "ocrAllowed": false,
    "clipboardImages": {
      "allowedMediaTypes": ["image/png"],
      "filePickerAllowed": true,
      "clipboardPasteAllowed": true,
      "imageInputEvidence": "unverified-visible-warning"
    }
  },
  "budgets": {
    "maximumFiles": 5,
    "maximumBytesPerFile": 65536,
    "maximumTotalBytes": 131072,
    "tokenEstimateDivisor": 4,
    "defaultMaximumImages": 2,
    "maximumImages": 4,
    "maximumBytesPerImage": 4194304,
    "maximumImageTotalBytes": 8388608,
    "maximumImageDimension": 4096,
    "maximumImagePixels": 16777216,
    "maximumImageTotalPixels": 33554432
  },
  "providerDisclosure": {
    "loopbackDisclosureRequired": true,
    "privateNetworkConfirmationRequired": true,
    "privateNetworkWarningRequired": true,
    "confirmationMechanism": "deliberate-submit-after-visible-warning",
    "separateConfirmationControlRequired": false,
    "publicProviderAllowed": false
  },
  "executionIsolation": {
    "attachmentContentTreatedAsData": true,
    "executableFormatsAllowed": false,
    "archiveExpansionAllowed": false,
    "contentDrivenProcessLaunchAllowed": false,
    "contentDrivenToolInvocationAllowed": false,
    "contentDrivenFilesystemAccessAllowed": false,
    "modelOutputExecutionAllowed": false,
    "antivirusScanningClaimed": false
  },
  "lifecycle": {
    "browserMemoryOnly": true,
    "serverPersistenceAllowed": false,
    "browserStorageAllowed": false,
    "temporaryFilesAllowed": false,
    "clearOnNewTask": true,
    "clearOnCapabilityChange": true,
    "clearOnModelChange": true,
    "clearOnProviderChange": true,
    "clearOnFailure": true,
    "clearOnShutdown": true
  },
  "retrieval": {
    "mode": "whole-selected-text-with-bounded-provider-payload",
    "semanticIndexAllowed": false,
    "persistentIndexAllowed": false
  }
}
