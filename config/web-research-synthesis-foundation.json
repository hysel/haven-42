  "contractId": "haven42.web-research.offline-cited-synthesis-foundation",
  "status": "offline-caller-fixture-only-no-model-authority",
  "limits": {
    "maximumSources": 10,
    "maximumPageSegmentsPerSource": 100,
    "maximumSegmentCharacters": 2000,
    "maximumContextCharacters": 20000,
