{
  "schemaVersion": 1,
  "kind": "haven42-model-coding-agent-qualification-policy",
  "purpose": "Fail-closed coding-agent screening required for every executable local-model candidate evaluated by Haven 42.",
  "scope": {
    "appliesTo": "every-new-executable-local-model-candidate",
    "doesNotChange": [
      "automatic-model-defaults",
      "support-labels",
      "managed-runtime-versions",
      "release-policy"
    ],
    "allowedStatuses": ["passed", "failed", "blocked", "not-run"]
  },
  "requiredGates": [
    {
      "id": "api-structured-code",
      "checks": ["valid-code-contract", "instruction-fidelity", "deterministic-output"]
    },
    {
      "id": "repository-read-plan-review",
      "checks": ["repository-context-use", "exact-filename-fidelity", "implementation-plan", "defect-review"]
    },
    {
      "id": "tool-contract",
      "checks": ["exact-tool-name", "schema-valid-arguments", "unknown-tool-refusal"]
    },
    {
      "id": "scoped-edit",
      "checks": ["explicit-write-approval", "expected-file-only", "external-git-diff", "no-unintended-writes"]
    },
    {
      "id": "reliability",
      "checks": ["bounded-context", "timeout-recovery", "post-failure-recovery", "model-unload"]
    }
  ],
  "surfaceAdmission": {
    "codingRecommendationRequires": [
      "all-required-gates-passed",
      "same-surface-disposable-repository-read-pass",
      "same-surface-disposable-repository-review-pass",
      "same-surface-disposable-repository-scoped-write-pass",
      "same-surface-unintended-write-check-pass"
    ],
    "separateEvidenceCells": [
      "maintained-cli-agent-and-version",
      "vscode-and-extension-version",
      "vscodium-and-extension-version",
      "vscode-native-chat-and-version",
      "vscodium-native-chat-and-version"
    ],
    "crossSurfaceInheritance": "forbidden",
    "legacyEvidenceOnlySurfaces": [
      "continue-cli",
      "vscode-continue-extension",
      "vscodium-continue-extension"
    ]
  },
  "evidenceRules": {
    "disposableRepositoriesOnlyForWrites": true,
    "rawPromptsCommitted": false,
    "rawResponsesCommitted": false,
    "privateEndpointsCommitted": false,
    "exactRuntimeModelDigestHardwareAndSurfaceRequired": true,
    "missingGateBlocksRecommendation": true
  }
}
