{
  "schemaVersion": 1,
  "contractId": "haven42.web-research.native-query-transport",
  "status": "owner-approved-fixed-provider-runtime",
  "adapterContract": "config/web-research-query-adapter.json",
  "providerId": "wikipedia-query",
  "network": {
    "fixedHost": "en.wikipedia.org",
    "fixedPort": 443,
    "fixedPath": "/w/api.php",
    "systemTrustStoreRequired": true,
    "dnsPassesRequired": 2,
    "publicIpOnly": true,
    "selectedIpPinnedForConnection": true,
    "redirectsAllowed": false,
    "responseCompressionAllowed": false,
    "proxyEnvironmentInherited": false,
    "credentialsAllowed": false,
    "cookiesAllowed": false,
    "timeoutSeconds": 10,
    "maximumResponseBytes": 65536,
    "requiredContentType": "application/json"
  },
  "authority": {
    "explicitDevelopmentCliAllowed": true,
    "queryNetworkAllowed": true,
    "runtimeRouteAllowed": true,
    "uiControlAllowed": true,
    "modelToolAllowed": false,
    "pageRetrievalAllowed": true,
    "activeNavigationAllowed": false,
    "persistenceAllowed": false,
    "automaticFollowUpAllowed": false,
    "packageAdmissionAllowed": true
  }
}
