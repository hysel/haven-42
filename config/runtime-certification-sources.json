{
  "schemaVersion": 1,
  "contractId": "haven42.on-demand-runtime-certification",
  "defaultDecision": "deny",
  "rules": {
    "officialReleaseSourcesOnly": true,
    "draftReleasesAllowed": false,
    "prereleaseReleasesAllowed": false,
    "mutableLatestAllowedForDiscoveryOnly": true,
    "immutableTagRequiredForEvidence": true,
    "artifactSha256Required": true,
    "artifactByteLengthRequired": true,
    "downloadsModelsOrRuntimes": false,
    "startsNativeTests": false,
    "writesCompatibilityRegistry": false,
    "changesManagedDefaults": false,
    "changesSupportLabels": false,
    "changesReleasePolicy": false
  },
  "requiredCertificationGates": [
    "official-release-and-source-identity",
    "license-and-redistribution-review",
    "artifact-digest-and-bounded-archive-review",
    "native-install-start-health-stop-cleanup",
    "model-task-regression",
    "hardware-backend-and-resource-use",
    "interruption-recovery-and-uninstall",
    "managed-setup-source-package-parity",
    "accessibility-and-novice-flow",
    "documentation-and-known-limitations",
    "owner-promotion-decision"
  ],
  "sources": [
    {
      "id": "ollama",
      "displayName": "Ollama",
      "repository": "ollama/ollama",
      "releaseApi": "https://api.github.com/repos/ollama/ollama/releases/latest",
      "releasePagePrefix": "https://github.com/ollama/ollama/releases/tag/",
      "downloadPrefix": "https://github.com/ollama/ollama/releases/download/",
      "tagPattern": "^v([0-9]+\\.[0-9]+\\.[0-9]+)$",
      "trackedCollection": "runtimes",
      "assetProfiles": [
        {"platform": "windows-x64", "backend": "core", "role": "runtime", "namePattern": "^ollama-windows-amd64\\.zip$"},
        {"platform": "windows-x64", "backend": "rocm", "role": "runtime-supplement", "namePattern": "^ollama-windows-amd64-rocm\\.zip$"},
        {"platform": "linux-x64", "backend": "core", "role": "runtime", "namePattern": "^ollama-linux-amd64\\.tar\\.zst$"},
        {"platform": "linux-x64", "backend": "rocm", "role": "runtime-supplement", "namePattern": "^ollama-linux-amd64-rocm\\.tar\\.zst$"}
      ]
    },
    {
      "id": "llama-cpp",
      "displayName": "llama.cpp",
      "repository": "ggml-org/llama.cpp",
      "releaseApi": "https://api.github.com/repos/ggml-org/llama.cpp/releases/latest",
      "releasePagePrefix": "https://github.com/ggml-org/llama.cpp/releases/tag/",
      "downloadPrefix": "https://github.com/ggml-org/llama.cpp/releases/download/",
      "tagPattern": "^b([1-9][0-9]*)$",
      "trackedCollection": "llamaCppRuntimes",
      "assetProfiles": [
        {"platform": "windows-x64", "backend": "cpu", "role": "runtime", "namePattern": "^llama-b[0-9]+-bin-win-cpu-x64\\.zip$"},
        {"platform": "windows-x64", "backend": "cuda", "role": "runtime", "namePattern": "^llama-b[0-9]+-bin-win-cuda-[0-9.]+-x64\\.zip$"},
        {"platform": "windows-x64", "backend": "rocm", "role": "runtime", "namePattern": "^llama-b[0-9]+-bin-win-rocm-[0-9.]+-x64\\.zip$"},
        {"platform": "windows-x64", "backend": "sycl", "role": "runtime", "namePattern": "^llama-b[0-9]+-bin-win-sycl-x64\\.zip$"},
        {"platform": "windows-x64", "backend": "vulkan", "role": "runtime", "namePattern": "^llama-b[0-9]+-bin-win-vulkan-x64\\.zip$"},
        {"platform": "linux-x64", "backend": "cpu", "role": "runtime", "namePattern": "^llama-b[0-9]+-bin-ubuntu-x64\\.tar\\.gz$"},
        {"platform": "linux-x64", "backend": "rocm", "role": "runtime", "namePattern": "^llama-b[0-9]+-bin-ubuntu-rocm-[0-9.]+-x64\\.tar\\.gz$"},
        {"platform": "linux-x64", "backend": "sycl", "role": "runtime", "namePattern": "^llama-b[0-9]+-bin-ubuntu-sycl(?:-fp16)?-x64\\.tar\\.gz$"},
        {"platform": "linux-x64", "backend": "vulkan", "role": "runtime", "namePattern": "^llama-b[0-9]+-bin-ubuntu-vulkan-x64\\.tar\\.gz$"}
      ]
    }
  ]
}
